{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/intent-guard-modification-backlog.schema.json",
  "title": "Intent Guard Lab Modification Backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "reviewedRevision", "planStatus", "tasks", "verification"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "repository": { "type": "string" },
    "reviewedRevision": { "type": "string" },
    "planStatus": { "const": "proposed" },
    "sourceUpgradeProposal": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "priority", "phase", "status", "dependsOn", "files", "actions", "acceptanceCriteria"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "phase": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["proposed", "in_progress", "blocked", "deferred", "done"] },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "files": { "type": "array", "items": { "type": "string" } },
          "actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "risks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testsExecuted", "reason", "repositoryFilesModified"],
      "properties": {
        "testsExecuted": { "type": "boolean" },
        "reason": { "type": "string" },
        "repositoryFilesModified": { "type": "boolean" }
      }
    }
  }
}
